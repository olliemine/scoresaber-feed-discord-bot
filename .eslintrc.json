{
    "env": {
        "node": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "overrides": [
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
		"requireConfigFile": false,
		"babelOptions": {
			"plugins": [
				"@babel/plugin-syntax-import-assertions"
			]
		}
    },
    "rules": {
		"no-inner-declarations": "off"
	},
	"parser": "@babel/eslint-parser"
}
