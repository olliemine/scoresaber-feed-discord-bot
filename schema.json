{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"definitions": {
		"regexMessage": {
			"anyOf": [{
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"enum": ["message"]
					},
					"message": {
						"type": "string",
						"maxLength": 2048
					},
					"buttons": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"minItems": 1,
						"maxItems": 5
					}
				},
				"required": ["type", "message"]
			}, {
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"enum": ["embed"]
					},
					"embedTitle": {
						"type": "string",
						"maxLength": 256
					},
					"embedDescription": {
						"type": "string",
						"maxLength": 4096
					},
					"embedFields": {
						"type": "object",
						"propertyNames": {
							"anyOf": [{
								"type": "string",
								"pattern": "^\\d+$"	
							}]
						},
						"additionalProperties": {
							"type": "array",
							"items": [{
								"$comment": "fieldTitle",
								"type": "string",
								"maxLength": 256
							}, {
								"$comment": "fieldDescription",
								"type": "string",
								"maxLength": 1024
							}, {
								"$comment": "inlineField",
								"type": "boolean",
								"default": false
							}, {
								"$comment": "Checks if variable exists on regex before creating the field",
								"type": "string",
								"default": null
							}],
							"minItems": 1,
							"maxItems": 4,
							"additionalItems": false
						}
					},
					"embedColor": {
						"type": "object",
						"properties": {
							"value": {
								"type": "string"
							},
							"type": {
								"type": "string"
							}
						},
						"additionalProperties": false,
						"required": ["value", "type"]
					},
					"embedThumbnail": {
						"type": "string"
					},
					"embedImage": {
						"type": "string"
					},
					"buttons": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"minItems": 1,
						"maxItems": 5
					},
					"embedURL": {
						"type": "string"
					}
				},
				"required": ["type"]
			}]
		},
		"mapFeeds": {
			"type": "string",
			"pattern": "^((Top1|NewMap|NewPlay|BetterPlay|BetterTopPlay|Snipe)(All|MainCountries)?|TopPlay(Personal|Country|All|Top([1-9]|1[0-9]|20)))$"
		},
		"mapFeedMessages": {
			"type": "string",
			"description": "feedMessages keys. Includes TopPlayTop (covers all TopPlayTopN) and bare TopPlay.",
			"pattern": "^((Top1|NewMap|NewPlay|BetterPlay|BetterTopPlay|Snipe)(All|MainCountries)?|TopPlay(Personal|Country|All|Top([1-9]|1[0-9]|20)?))$"
		},
		"playerFeeds": {
			"type": "string",
			"pattern": "^(CountryRank|GlobalRank|MainCountriesRank|Top1QuantityMaps|Top1PercentageMaps|AverageAccuracy)(All|MainCountries)?$"
		},
		"playerFeedEvents": {
			"type": "string",
			"pattern": "^(CountryRank|GlobalRank|MainCountriesRank|Top1QuantityMaps|Top1PercentageMaps|AverageAccuracy)(All|MainCountries)?$"
		},
		"mapChannelFeedConfiguration": {
			"type": "object",
			"properties": {
				"Channel": {
					"type": "string"
				},
				"Feeds": {
					"anyOf": [{
						"type": "string",
						"const": "all"
					}, {
						"type": "array",
						"items": {
							"$ref": "#/definitions/mapFeeds"
						},
						"minItems": 1
					}]
				},
				"Types": {
					"type": "string",
					"enum": ["both", "unranked", "ranked"],
					"default": "both"
				},
				"minPP": {
					"type": "number",
					"minimum": 0,
					"description": "Inclusive minimum play PP for this channel entry (score.pp >= minPP)."
				},
				"maxPP": {
					"type": "number",
					"minimum": 0,
					"description": "Exclusive maximum play PP for this channel entry (score.pp < maxPP)."
				}
			},
			"required": ["Channel", "Feeds"],
			"additionalProperties": false
		},
		"playerChannelFeedConfiguration": {
			"type": "object",
			"properties": {
				"Channel": {
					"type": "string"
				},
				"Feeds": {
					"anyOf": [{
						"type": "string",
						"const": "all"
					}, {
						"type": "array",
						"items": {
							"$ref": "#/definitions/playerFeeds"
						},
						"minItems": 1
					}]
				}
			},
			"required": ["Channel", "Feeds"],
			"additionalProperties": false
		},
		"credential": {
			"type": "object",
			"properties": {
				"use-hidden-variable": {
					"type": "boolean",
					"default": false
				},
				"variable": {
					"type": "string"
				}
			},
			"required": ["use-hidden-variable", "variable"],
			"additionalProperties": false
		},
		"log": {
			"type": "object",
			"properties": {
				"on-console": {
					"type": "boolean",
					"default": true
				},
				"discord-channel-id": {
					"type": "string"
				} 
			},
			"additionalProperties": false
		}
	},
	"properties": {
		"server-id": {
			"type": "string"
		},
		"botAuthor": {
			"type": "string",
			"title": "used in the creation of playlists"
		},
		"masters-user-ids": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"main-countries": {
			"type": "array",
			"items": {
				"type": "string",
				"maxLength": 2
			},
			"default": []
		},
		"bot-channels": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"admin-roles": {
			"type":"array",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"language": {
			"type": "string",
			"maxLength": 2,
			"default": "en",
			"enum": ["en", "es"]
		},
		"activity": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"type": {
					"type": "number",
					"enum": [0, 1, 2, 3, 5]
				}
			},
			"additionalProperties": false,
			"required": ["name", "type"]
		},
		"database": {
			"type": "object",
			"properties": {
				"user-login": {
					"type": "object",
					"properties": {
						"do-discord-nicknames": {
							"type": "boolean",
							"default": false
						},
						"discord-nicknames": {
							"type": "object",
							"properties": {
								"MainCountryUser": {
									"type": "string"
								},
								"NonMainCountryUser": {
									"type": "string"
								},
								"InactiveUser": {
									"type": "string"
								},
								"BannedUser": {
									"type": "string"
								},
								"Visitor": {
									"type": "string"
								}
							},
							"additionalProperties": false
						},
						"give-roles": {
							"type": "object",
							"properties": {
								"MainCountryUser": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"default": []
								},
								"NonMainCountryUser": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"default": []
								},
								"InactiveUser": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"default": []
								},
								"BannedUser": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"default": []
								},
								"Visitor": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"default": []
								}
							},
							"additionalProperties": false
						},
						"default-values": {
							"type": "object",
							"properties": {
								"doSnipePing": {
									"type": "boolean",
									"default": false
								}
							},
							"additionalProperties": false
						},
						"disable-warnings": {
							"type": "boolean",
							"default": false
						},
						"IsVisitorWithoutDeclaring": {
							"type": "boolean",
							"default": false
						},
						"VerificationChannel": {
							"type": "object",
							"properties": {
								"enabled": {
									"type": "boolean",
									"default": false
								},
								"id": {
									"type": "string"
								},
								"deleteMessages": {
									"type": "boolean",
									"default": false
								},
								"haveInstructionMessage": {
									"type": "boolean",
									"default": false
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"players": {
					"type": "object",
					"properties": {
						"Unknowns": {
							"type": "object",
							"properties": {
								"SaveUnknowns": {
									"type": "boolean",
									"default": false
								}
							},
							"additionalProperties": false
						},
						"update": {
							"type": "object",
							"properties": {
								"enable-updates-for-NonMainCountryUsers": {
									"type": "boolean",
									"default": false
								},
								"ppLimit": {
									"type": "number",
									"minimum": 10,
									"default": 1000
								}
							},
							"additionalProperties": false
						},
						"roles": {
							"type": "object",
							"properties": {
								"GiveRankRolestoInactiveUsers": {
									"type": "boolean",
									"default": true
								},
								"list": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"from": {
												"type": "number",
												"minimum": 0,
												"default": 0
											},
											"to": {
												"type": "number",
												"minimum": 0,
												"default": 0
											},
											"country": {
												"type": "array",
												"items": {
													"type": "string",
													"pattern": "^([A-Z]{2})$",
													"maxLength": 2
												},
												"default": []
											},
											"ids": {
												"type": "array",
												"items": {
													"type": "string"
												},
												"minItems": 1
											},
											"global": {
												"type": "boolean",
												"default": false
											}
										},
										"additionalProperties": false,
										"required": ["ids"]
									},
									"default": []
								}
							},
							"additionalProperties": false
						},
						"feed": {
							"type": "object",
							"properties": {
								"doPingsPlayer": {
									"type": "boolean",
									"default": false
								},
								"doPingsSniped": {
									"type": "boolean",
									"default": false
								},
								"feeds": {
									"type": "array",
									"items": {
										"$ref": "#/definitions/playerChannelFeedConfiguration"
									},
									"minItems": 1
								},
								"feedMessages": {
									"type": "object",
									"propertyNames": {
										"$ref": "#/definitions/playerFeedEvents"
									},
									"additionalProperties": {
										"$ref": "#/definitions/regexMessage"
									}
								}
							},
						"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"maps": {
					"type": "object",
					"properties": {
						"Unknowns": {
							"type": "object",
							"properties": {
								"findUntilNotUnknown": {
									"type": "boolean",
									"default": false
								},
								"searched": {
									"type": "boolean",
									"default": true
								},
								"canHaveTopPlay": {
									"type": "boolean",
									"default": true
								},
								"canBeSniped": {
									"type": "boolean",
									"default": true
								},
								"canSnipe": {
									"type": "boolean",
									"default": true
								},
								"canSnipeUnknowns": {
									"type": "boolean",
									"default": true
								},
								"canHaveBetterScore": {
									"type": "boolean",
									"default": true
								},
								"canDoNewPlay": {
									"type": "boolean",
									"default": true
								},
								"canDoNewMap": {
									"type": "boolean",
									"default": true
								}
							},
							"additionalProperties": false
						},
						"feed": {
							"type": "object",
							"properties": {
								"doPingsPlayerA": {
									"type": "boolean",
									"default": false
								},
								"doPingsPlayerB": {
									"type": "boolean",
									"default": false
								},
								"betterPlayPercentage": {
									"type": "number",
									"default": 2,
									"minimum": 0,
									"maximum": 99
								},
								"top1IfNoUsers": {
									"type": "boolean",
									"default": false
								},
								"feeds": {
									"type": "array",
									"items": {
										"$ref": "#/definitions/mapChannelFeedConfiguration"
									},
									"minItems": 1
								},
								"feedMessages": {
									"type": "object",
									"propertyNames": {
										"$ref": "#/definitions/mapFeedMessages"
									},
									"additionalProperties": {
										"$ref": "#/definitions/regexMessage"
									}
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"suspendedUsersForLeaderboards": {
					"type": "boolean",
					"default": true,
					"title": "If suspended users (inactive users and banned users) are to be included in leaderboard calculations (PP, Rank, CountryRank, AverageAccuracy)"
				},
				"suspendedUsersForMapLeaderboards": {
					"type": "boolean",
					"default": true,
					"title": "If suspended users (inactive users and banned users) are to be included in map leaderboard calculations"
				}
			},
			"additionalProperties": false
		},
		"messages": {
			"type": "object",
			"properties": {
				"enable-dm": {
					"type": "boolean",
					"default": true
				},
				"only-work-on-server": {
					"type": "boolean",
					"default": true
				}
			},
			"additionalProperties": false
		},
		"commands": {
			"type": "object",
			"properties": {
				"getplayer": {
					"$ref": "#/definitions/regexMessage"
				},
				"rankedle": {
					"type": "object",
					"title": "Rankedle song guessing game",
					"properties": {
						"channelId": {
							"title": "Channel the game can be started in, the command is unavailable while unset",
							"type": "string"
						},
						"countdownSeconds": {
							"title": "Seconds players get to join before the first round",
							"type": "number",
							"minimum": 5,
							"default": 20
						},
						"audioClipDuration": {
							"title": "Seconds of audio played each round",
							"type": "number",
							"minimum": 1,
							"default": 5
						},
						"extendedAudioClipDuration": {
							"title": "Seconds of audio played by the extended audio hint",
							"type": "number",
							"minimum": 1,
							"default": 10
						},
						"maxPointsPerGame": {
							"title": "Points needed to win a game",
							"type": "number",
							"minimum": 1,
							"default": 5
						},
						"waitBetweenRounds": {
							"title": "Seconds between the end of a round and the next one",
							"type": "number",
							"minimum": 0,
							"default": 5
						},
						"roundTimeLimit": {
							"title": "Seconds players get to guess each round",
							"type": "number",
							"minimum": 10,
							"default": 120
						},
						"downloadTimeoutMS": {
							"title": "Milliseconds before a map download is aborted and another song is picked",
							"type": "number",
							"minimum": 1000,
							"default": 15000
						},
						"minStars": {
							"title": "Only pick ranked maps at or above this star rating",
							"type": "number",
							"minimum": 0
						},
						"maxStars": {
							"title": "Only pick ranked maps at or below this star rating",
							"type": "number",
							"minimum": 0
						},
						"embedColor": {
							"type": "string",
							"pattern": "^#([0-9A-Fa-f]{6})$",
							"default": "#FF5733"
						}
					}
				},
				"birthdays": {
					"type": "object",
					"title": "Birthday tracking",
					"properties": {
						"channelId": {
							"title": "Channel birthdays are announced in, announcements are disabled while unset",
							"type": "string"
						},
						"announceHourUTC": {
							"title": "Hour of the day, in UTC, birthdays are announced at",
							"type": "number",
							"minimum": 0,
							"maximum": 23,
							"default": 9
						}
					}
				},
				"disableCommandsForBaseUsers": {
					"title": "Meant for testing purposes, disables commands for all base users",
					"type": "boolean",
					"default": false
				},
				"disabling": {
					"type": "array",
					"title": "Disable commands",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"logger": {
			"type": "object",
			"properties": {
				"enableTimestamp": {
					"type": "boolean",
					"default": false
				},
				"logs": {
					"type": "object",
					"properties": {
						"info": {
							"$ref": "#/definitions/log"
						},
						
						"warn": {
							"$ref": "#/definitions/log"
						},
			
						"error": {
							"$ref": "#/definitions/log"
						},
			
						"debug": {
							"$ref": "#/definitions/log"
						},
			
						"fatal": {
							"$ref": "#/definitions/log"
						},
			
						"configuration": {
							"$ref": "#/definitions/log"
						}
					},
					"additionalProperties": false
				}
			},
			"required": ["enableTimestamp", "logs"],
			"additionalProperties": false
		},
		"debug": {
			"type": "number",
			"minimum": 0,
			"maximum": 6,
			"default": 0
		},
		"loadingEmoji": {
			"title": "String for the discord loading emoji",
			"type": "string"
		},
		"scoresaberEmoji": {
			"title": "String for the discord scoresaber emoji",
			"type": "string"
		},
		"beatsaverEmoji": {
			"title": "String for the discord beatsaver emoji",
			"type": "string"
		},
		"testMode": {
			"title": "Enables or disables test mode (testconfig.json and testing environmentals env.DISCORD_TOKEN_TESTING & env.MONGODB_URI_TESTING)",
			"default": true,
			"type": "boolean"
		},
		"$schema": true
	},
	"additionalProperties": false,
	"required": ["server-id", "botAuthor"]
}